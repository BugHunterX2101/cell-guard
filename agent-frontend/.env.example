# API Gateway URL output by `sam deploy` in this folder.
VITE_AGENT_API_URL=http://localhost:3001/chat

# gateway-policy's ModeUrl stack output — GET reads the current LOG_ONLY/
# ENFORCE mode, POST {"mode": "..."} flips it. Called directly by the
# mode-flip button in the UI, never through the agent. Omit locally to use
# the dev-only mock at /mode (see vite.config.ts).
VITE_GATEWAY_MODE_URL=https://REPLACE_ME.execute-api.us-east-1.amazonaws.com/prod/mode
