{
  "info": {
    "name": "Cell-Guard — Gateway Contract",
    "description": "Exercises POST /invoke-tool directly, independent of the agent. Set the {{gatewayUrl}} collection variable to the deployed InvokeToolUrl stack output.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "https://REPLACE_ME.execute-api.us-east-1.amazonaws.com/prod/invoke-tool" }
  ],
  "item": [
    {
      "name": "1. Happy path — approve_expense within threshold (expect ALLOW)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"approve_expense\",\n  \"params\": { \"amount\": 120, \"employee_id\": \"emp-42\" },\n  \"principal\": { \"user_id\": \"agent-session-1\", \"role\": \"agent\" },\n  \"context\": { \"session_id\": \"sess-001\", \"source\": \"chat\" }\n}"
        }
      }
    },
    {
      "name": "2. Attack — approve_expense over threshold via injected_doc (expect DENY)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"approve_expense\",\n  \"params\": { \"amount\": 50000, \"employee_id\": \"emp-42\" },\n  \"principal\": { \"user_id\": \"agent-session-1\", \"role\": \"agent\" },\n  \"context\": { \"session_id\": \"sess-002\", \"source\": \"injected_doc\" }\n}"
        }
      }
    },
    {
      "name": "3. Attack — delete_customer_record (expect DENY, unconditional)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"delete_customer_record\",\n  \"params\": { \"customer_id\": \"cust-1001\" },\n  \"principal\": { \"user_id\": \"agent-session-1\", \"role\": \"agent\" },\n  \"context\": { \"session_id\": \"sess-003\", \"source\": \"injected_doc\" }\n}"
        }
      }
    },
    {
      "name": "4. Happy path — send_wire_transfer within threshold (expect ALLOW)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"send_wire_transfer\",\n  \"params\": { \"amount\": 250, \"recipient\": \"vendor-acct-9\" },\n  \"principal\": { \"user_id\": \"agent-session-1\", \"role\": \"agent\" },\n  \"context\": { \"session_id\": \"sess-004\", \"source\": \"chat\" }\n}"
        }
      }
    },
    {
      "name": "5. Attack — send_wire_transfer over threshold (expect DENY)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"send_wire_transfer\",\n  \"params\": { \"amount\": 25000, \"recipient\": \"attacker-acct\" },\n  \"principal\": { \"user_id\": \"agent-session-1\", \"role\": \"agent\" },\n  \"context\": { \"session_id\": \"sess-005\", \"source\": \"injected_doc\" }\n}"
        }
      }
    },
    {
      "name": "6. Malformed — unknown tool (expect HTTP 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"wipe_database\",\n  \"params\": {},\n  \"principal\": { \"user_id\": \"agent-session-1\", \"role\": \"agent\" },\n  \"context\": { \"session_id\": \"sess-006\", \"source\": \"injected_doc\" }\n}"
        }
      }
    }
  ]
}
